#version 460
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer PlanBuffer {
    uint plan_data[];
};
layout(set = 0, binding = 1, std430) buffer WorkspaceBuffer {
    uint workspace_data[];
};
layout(set = 0, binding = 2, std430) buffer CacheBuffer {
    uint cache_data[];
};
layout(push_constant, std430) uniform PushConstants {
    uint value[32];
} pc;

double plan_double(uint word) {
    return packDouble2x32(uvec2(plan_data[word], plan_data[word + 1U]));
}

double double_epsilon() {
    return packDouble2x32(uvec2(0U, 0x3cb00000U));
}

double ordered_add_product(double value, double coefficient, double source) {
    precise double product = coefficient * source;
    precise double result = value + product;
    return result;
}

double ordered_subtract_product(
    double value, double coefficient, double source) {
    precise double product = coefficient * source;
    precise double result = value - product;
    return result;
}

double source_value(uint vector, uint index) {
    uint linear;
    if (pc.value[7] == 0U) {
        linear = index * pc.value[3] + vector;
    } else {
        linear = vector * pc.value[0] + index;
    }
    const uint word = pc.value[4] + linear * 2U;
    const uvec2 bits = pc.value[6] == 0U
        ? uvec2(workspace_data[word], workspace_data[word + 1U])
        : uvec2(cache_data[word], cache_data[word + 1U]);
    return packDouble2x32(bits);
}

uint output_word(uint vector, uint index) {
    const uint linear = pc.value[8] == 0U
        ? index * pc.value[3] + vector
        : vector * pc.value[1] + index;
    return pc.value[5] + linear * 2U;
}

double output_value(uint vector, uint index) {
    const uint word = output_word(vector, index);
    return packDouble2x32(
        uvec2(workspace_data[word], workspace_data[word + 1U]));
}

void store_output(uint vector, uint index, double result) {
    if (isnan(result) || isinf(result)) {
        atomicOr(workspace_data[pc.value[16]], 1U);
    }
    const uint word = output_word(vector, index);
    const uvec2 bits = unpackDouble2x32(result);
    workspace_data[word] = bits.x;
    workspace_data[word + 1U] = bits.y;
}

double lower_factor(uint size, uint index, uint distance) {
    const uint element = pc.value[15] != 0U
        ? distance * size + index - distance
        : (distance - 1U) * size + index;
    return plan_double(pc.value[12] + element * 2U);
}

double upper_factor(uint size, uint index, uint distance) {
    const uint element = pc.value[15] != 0U
        ? distance * size + index
        : (distance - 1U) * size + index;
    return plan_double(pc.value[13] + element * 2U);
}

void inverse_axis(uint vector, uint bandwidth) {
    const uint size = pc.value[1];
    for (uint index = 0U; index < size; ++index) {
#if DSMVC_SOLVE_ONLY
        double sum = output_value(vector, index);
#else
        double sum = 0.0LF;
        const uint begin = plan_data[pc.value[9] + index];
        const uint end = plan_data[pc.value[9] + index + 1U];
        for (uint position = begin; position < end; ++position) {
            sum = ordered_add_product(
                sum,
                plan_double(pc.value[11] + position * 2U),
                source_value(vector, plan_data[pc.value[10] + position]));
        }
#endif
        const uint available = min(bandwidth, index);
        for (uint distance = available; distance > 0U; --distance) {
            sum = ordered_subtract_product(
                sum, lower_factor(size, index, distance),
                output_value(vector, index - distance));
        }
        if (pc.value[15] == 0U) {
            sum *= plan_double(pc.value[14] + index * 2U);
        }
        store_output(vector, index, sum);
    }

    if (pc.value[15] != 0U) {
        for (uint index = 0U; index < size; ++index) {
            const double diagonal =
                plan_double(pc.value[12] + index * 2U) + double_epsilon();
            const double inverse =
                plan_double(pc.value[14] + index * 2U);
            const double value = output_value(vector, index);
            const double quotient = value * inverse;
            const double remainder = fma(-quotient, diagonal, value);
            store_output(vector, index, fma(remainder, inverse, quotient));
        }
    }

    if (size < 2U) return;
    for (uint reverse = size - 1U; reverse > 0U; --reverse) {
        const uint index = reverse - 1U;
        const uint available = min(bandwidth, size - index - 1U);
        double sum = output_value(vector, index);
        for (uint distance = available; distance > 0U; --distance) {
            sum = ordered_subtract_product(
                sum, upper_factor(size, index, distance),
                output_value(vector, index + distance));
        }
        store_output(vector, index, sum);
    }
}

void main() {
    const uint vector = gl_GlobalInvocationID.x;
    if (vector >= pc.value[3]) return;
    inverse_axis(vector, pc.value[2]);
}
